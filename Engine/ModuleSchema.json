{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACNextGen Physics Module",
  "type": "object",
  "required": [
    "metadata",
    "inputs",
    "parameters",
    "state",
    "formula",
    "conditions",
    "outputs",
    "dependencies",
    "limits"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domain",
        "version",
        "description",
        "enabled"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "parameters": {
      "type": "object"
    },
    "state": {
      "type": "object"
    },
    "formula": {
      "type": "object"
    },
    "conditions": {
      "type": "array"
    },
    "outputs": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object"
    }
  }
}